{
  "kind": "collectionType",
  "collectionName": "employees",
  "info": {
    "singularName": "employee",
    "pluralName": "employees",
    "displayName": "Employee"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "employee_no": {
      "type": "string",
      "unique": true
    },
    "employee_name": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "basic_pay": {
      "type": "decimal",
      "default": 0
    },
    "honorarium": {
      "type": "decimal",
      "default": 0
    },
    "premium": {
      "type": "decimal"
    },
    "amount_per_unit": {
      "type": "integer"
    },
    "sss": {
      "type": "decimal",
      "default": 0
    },
    "philhealth": {
      "type": "decimal",
      "default": 0
    },
    "pagibig": {
      "type": "decimal",
      "default": 0
    },
    "cash_advance_amount": {
      "type": "decimal",
      "default": 0
    },
    "cash_advance_balance": {
      "type": "decimal",
      "default": 0
    },
    "payslips": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payslip.payslip",
      "mappedBy": "employee"
    },
    "cash_advances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cash-advance.cash-advance",
      "mappedBy": "employee"
    },
    "cisco_rate": {
      "type": "integer",
      "default": 0
    },
    "rle_rate": {
      "type": "integer",
      "default": 0
    },
    "sss_loan": {
      "type": "decimal",
      "default": 0
    },
    "pagibig_loan": {
      "type": "decimal",
      "default": 0
    }
  }
}
