{
  "kind": "collectionType",
  "collectionName": "payroll_periods",
  "info": {
    "singularName": "payroll-period",
    "pluralName": "payroll-periods",
    "displayName": "PayrollPeriod"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "payroll_period": {
      "type": "string"
    },
    "payroll_period_start": {
      "type": "date"
    },
    "payroll_period_end": {
      "type": "date"
    },
    "payslips": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payslip.payslip",
      "mappedBy": "payroll_period"
    },
    "cash_advance_payment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::cash-advance-payment.cash-advance-payment",
      "mappedBy": "payroll_period"
    },
    "cut_off_type": {
      "type": "enumeration",
      "enum": [
        "first_half",
        "second_half"
      ]
    },
    "pay_date": {
      "type": "date"
    },
    "payroll_approved": {
      "type": "boolean",
      "default": false
    },
    "user_info": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-info.user-info",
      "inversedBy": "payroll_periods"
    }
  }
}
